                <mxCell id="s3b" value="DevAI creates K8s Job&#xa;profile baked into env:&#xa;&#xa;DEVAI_AGENT_PROFILE&#xa;DEVAI_TRIGGERED_BY&#xa;DEVAI_TRACE_ID&#xa;DEVAI_AGENTGATEWAY_URL&#xa;&#xa;Runner pod boots with&#xa;everything it needs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d5a3d;strokeColor=#2a4030;fontColor=#fff;fontSize=13" parent="1" vertex="1">
