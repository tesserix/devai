                <mxCell id="key" value="Key insight: the aregistry call happens ONCE per dispatch.&#xa;The runner reads its profile from env vars baked into the Job by DevAI —&#xa;it does NOT re-query aregistry on boot." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7d6;strokeColor=#c89c00;fontSize=14;fontStyle=2" parent="1" vertex="1">
