        <mxCell id="owners" value="10  DURABLE OWNERS&#xa;&#xa;Product APIs + PostgreSQL&#xa;Temporal workflow history&#xa;SCM + object storage&#xa;Mutation + idempotency truth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;dashed=1;fontColor=#0f172a;fontSize=15;fontStyle=1;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="1950" y="825" width="300" height="165" as="geometry"/></mxCell>

