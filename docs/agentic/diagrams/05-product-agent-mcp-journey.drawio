        <mxCell id="title" value="Product request → DevAI agent → governed MCP tools → observable result" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#111827" vertex="1" parent="1"><mxGeometry x="300" y="20" width="1800" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Read left to right, then follow the numbered step down to the next row" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#4b5563" vertex="1" parent="1"><mxGeometry x="500" y="65" width="1400" height="30" as="geometry"/></mxCell>

        <mxCell id="controlLane" value="1 · REQUEST AND CONTROL PLANE" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#eef2ff;strokeColor=#6366f1;fontColor=#312e81;fontStyle=1;fontSize=14" vertex="1" parent="1"><mxGeometry x="60" y="120" width="2280" height="270" as="geometry"/></mxCell>
        <mxCell id="product" value="1  PRODUCT / USER&#xa;&#xa;UI · API · webhook&#xa;&#xa;Request + authenticated principal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;fontSize=15;fontStyle=1;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="120" y="205" width="240" height="125" as="geometry"/></mxCell>
        <mxCell id="api" value="2  DevAI API&#xa;&#xa;Authenticate tenant&#xa;Validate request + limits&#xa;Create run ID + trace ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#1e1b4b;fontColor=#ffffff;fontSize=15;fontStyle=1;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="440" y="195" width="250" height="145" as="geometry"/></mxCell>
        <mxCell id="workflow" value="3  BLUEPRINT + TEMPORAL&#xa;&#xa;Choose the next agent stage&#xa;Persist progress + retries&#xa;Resume long-running work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#1e1b4b;fontColor=#ffffff;fontSize=15;fontStyle=1;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="770" y="195" width="270" height="145" as="geometry"/></mxCell>
        <mxCell id="registry" value="4  AGENT REGISTRY&#xa;&#xa;Resolve exact Agent version&#xa;Skills + prompts + tool refs&#xa;MCP servers + policy + digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b21a8;strokeColor=#4c1d95;fontColor=#ffffff;fontSize=15;fontStyle=1;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="1120" y="190" width="290" height="155" as="geometry"/></mxCell>
        <mxCell id="controlNote" value="The Registry defines what may run. It does not carry conversation state or execute tool calls." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;fontColor=#581c87;fontSize=14" vertex="1" parent="1"><mxGeometry x="1530" y="215" width="690" height="105" as="geometry"/></mxCell>

        <mxCell id="executionLane" value="2 · ONE GOVERNED AGENT EXECUTION" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#ecfdf5;strokeColor=#16a34a;fontColor=#14532d;fontStyle=1;fontSize=14" vertex="1" parent="1"><mxGeometry x="60" y="430" width="2280" height="300" as="geometry"/></mxCell>
        <mxCell id="executionNote" value="DISPATCH CONTRACT&#xa;&#xa;Verified composition snapshot&#xa;Bounded budgets and deadline&#xa;No mutable Registry lookup required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;fontColor=#14532d;fontSize=14" vertex="1" parent="1"><mxGeometry x="120" y="520" width="500" height="135" as="geometry"/></mxCell>
