        <mxCell id="toolLane" value="3 · MCP TOOL AND DURABLE DATA PLANE" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;fontStyle=1;fontSize=14" vertex="1" parent="1"><mxGeometry x="60" y="770" width="2280" height="270" as="geometry"/></mxCell>
        <mxCell id="stateless" value="STATELESS MCP RULE&#xa;&#xa;Any healthy replica can handle the next call.&#xa;Pods keep no durable user, conversation, workflow, or idempotency state.&#xa;Retries are safe because mutations use tenant-scoped idempotency keys." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;fontSize=15;fontStyle=1" vertex="1" parent="1"><mxGeometry x="120" y="850" width="1000" height="135" as="geometry"/></mxCell>
