# DevAI Configuration
# Copy to .env and fill in values

# --- NATS ---
DEVAI_NATS_URL=nats://localhost:4222

# --- Redis ---
DEVAI_REDIS_URL=redis://localhost:6379

# --- GitHub App ---
DEVAI_GITHUB_APP_ID=
DEVAI_GITHUB_APP_PRIVATE_KEY=
DEVAI_GITHUB_APP_INSTALLATION_ID=
DEVAI_GITHUB_WEBHOOK_SECRET=
DEVAI_GITHUB_ORG=tesserix

# --- GitHub OAuth (for dashboard login) ---
DEVAI_GITHUB_OAUTH_CLIENT_ID=
DEVAI_GITHUB_OAUTH_CLIENT_SECRET=

# --- Dashboard ---
DEVAI_DASHBOARD_BASE_URL=http://localhost:8080

# --- OpenAI / Codex ---
DEVAI_OPENAI_API_KEY=
DEVAI_OPENAI_MODEL=o3

# --- Anthropic / Claude ---
DEVAI_ANTHROPIC_API_KEY=
DEVAI_CLAUDE_MODEL=claude-sonnet-4-20250514
DEVAI_CLAUDE_MAX_TOKENS=8192

# --- Server ---
DEVAI_HOST=0.0.0.0
DEVAI_PORT=8080
DEVAI_LOG_LEVEL=info
