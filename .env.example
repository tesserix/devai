# DevAI Configuration
# Copy to .env and fill in values

# --- NATS ---
DEVAI_NATS_URL=nats://localhost:4222
DEVAI_NATS_STREAM=DEVAI
DEVAI_NATS_MAX_DELIVER=3
DEVAI_NATS_ACK_WAIT=300

# --- Event-bus adapter ---
# Selects the pub/sub backend. `nats` -> JetStream against DEVAI_NATS_URL.
# `noop` -> in-process loopback (handy for local dev without a broker).
# Missing SDK / unreachable broker degrade automatically to noop.
DEVAI_EVENT_BUS_PROVIDER=nats

# --- Redis ---
DEVAI_REDIS_URL=redis://localhost:6379

# --- GitHub App ---
DEVAI_GITHUB_APP_ID=
DEVAI_GITHUB_APP_PRIVATE_KEY=
DEVAI_GITHUB_APP_INSTALLATION_ID=
DEVAI_GITHUB_WEBHOOK_SECRET=
DEVAI_GITHUB_ORG=tesserix

# --- GitHub OAuth (for dashboard login) ---
DEVAI_GITHUB_OAUTH_CLIENT_ID=
DEVAI_GITHUB_OAUTH_CLIENT_SECRET=

# --- Dashboard ---
DEVAI_DASHBOARD_BASE_URL=http://localhost:8080

# --- Feedback support inbox ---
DEVAI_FEEDBACK_REPO=tesserix/devai
DEVAI_FEEDBACK_ASSIGNEES='["sam123ben","mahesh.sangawar"]'
# Stable login IDs or emails that may view every thread and close/reopen it.
DEVAI_FEEDBACK_SUPPORT_IDENTITIES='[]'

# --- OpenAI / Codex ---
DEVAI_OPENAI_API_KEY=
DEVAI_OPENAI_MODEL=o3

# --- Anthropic / Claude ---
DEVAI_ANTHROPIC_API_KEY=
DEVAI_CLAUDE_MODEL=claude-sonnet-5
DEVAI_CLAUDE_MAX_TOKENS=8192

# --- Agent gateway (required for policy-enforced LLM egress in production) ---
DEVAI_LLM_GATEWAY_BASE_URL=
DEVAI_LLM_GATEWAY_API_KEY=
DEVAI_LLM_GATEWAY_MODEL=
# When true, every provider uses its dedicated AgentGateway route and a missing
# gateway URL fails closed instead of dialing a provider directly.
DEVAI_LLM_GATEWAY_REQUIRED=false

# --- MCP AgentGateway ---
DEVAI_AGENTGATEWAY_URL=
# Optional operator-status endpoints; the AI probe falls back to the LLM base URL.
DEVAI_AGENTGATEWAY_CONTROLLER_URL=
DEVAI_AI_GATEWAY_URL=

# --- Per-user connector secrets (OpenBao + blind-write broker) ---
DEVAI_SECRETS_PROVIDER=noop
DEVAI_SECRETS_OPENBAO_ADDR=
DEVAI_SECRETS_OPENBAO_MOUNT=kv
DEVAI_SECRETS_OPENBAO_ROLE=read-devai-api
DEVAI_SECRETS_OPENBAO_AUTH_MOUNT=kubernetes
DEVAI_SECRETS_BROKER_URL=
DEVAI_SECRETS_BROKER_TOKEN_FILE=/var/run/secrets/devai/secret-service/token

# --- Server ---
DEVAI_HOST=0.0.0.0
DEVAI_PORT=8080
DEVAI_LOG_LEVEL=info

# --- Security ---
# Set to true to reject mutating requests (POST/PUT/PATCH/DELETE) that
# carry no resolvable principal (auth-bff X-Forwarded-* or devai_session).
# Default false trusts the auth-bff + Istio edge. Webhooks stay exempt
# (HMAC-authenticated).
DEVAI_REQUIRE_AUTH=false
# Shared secret the auth-bff echoes in X-Auth-Bff-Secret so the backend
# only trusts X-Forwarded-* identity from the bff. Empty = trust as today.
DEVAI_AUTH_BFF_SHARED_SECRET=
# Confine document-tool file reads (doc_read_pdf/markdown/openapi) to this
# directory. Empty = no confinement. Set to the per-run workspace root.
DEVAI_TOOL_WORKSPACE_ROOT=
