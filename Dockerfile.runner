# syntax=docker/dockerfile:1.7
ARG ADK_BASE=ghcr.io/tesserix/base-python-adk-3.13:20260827@sha256:575f845a640619b19a4612fd2fd483b85547ebbe47793b28b971534de3d4cfb9

FROM ${ADK_BASE} AS wheels

USER root
WORKDIR /build
COPY pyproject.toml .
COPY src/ src/
RUN python -m pip wheel --wheel-dir /wheels .

FROM ${ADK_BASE} AS base

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /devai/work \
    && chown -R 10001:10001 /devai
RUN --mount=type=bind,from=wheels,source=/wheels,target=/wheels,ro \
    python -m pip install --no-cache-dir --no-index --find-links=/wheels devai \
    && python -m pip check \
    && python -c "import importlib.metadata as m; assert m.version('tesserix-adk') == '0.51.0'"

USER 10001:10001
WORKDIR /devai/work
ENTRYPOINT ["/usr/bin/tini", "--", "python", "-m", "devai.runner.entrypoint"]

FROM base AS browser
USER root
ENV DISPLAY=:99 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        fluxbox \
        fonts-liberation \
        novnc \
        websockify \
        x11vnc \
        xvfb \
    && python -m playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/* \
    && chmod -R a+rX /ms-playwright
USER 10001:10001

FROM base AS runner
